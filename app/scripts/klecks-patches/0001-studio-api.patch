diff --git a/src/app/script/bb/input/event-chain/pencil-aware-limiter.ts b/src/app/script/bb/input/event-chain/pencil-aware-limiter.ts
new file mode 100644
index 0000000..9528ca7
--- /dev/null
+++ b/src/app/script/bb/input/event-chain/pencil-aware-limiter.ts
@@ -0,0 +1,60 @@
+import { TChainOutFunc } from './event-chain.types';
+import { TPointerEvent } from '../event.types';
+import { OnePointerLimiter } from './one-pointer-limiter';
+import { KL_CONFIG } from '../../../klecks/kl-config';
+
+/**
+ * [creatofolio patch] New file. Replaces OnePointerLimiter in the easel's chain.
+ *
+ * Pencil only OFF: exactly OnePointerLimiter.
+ * Pencil only ON: a pen/mouse pointer and a finger are tracked separately, and a
+ * resting palm can never block the Pencil: while the pen is down every finger
+ * event is dropped (and a finger that lands during a stroke stays ignored until
+ * it lifts). The easel pans with whatever finger events come out (see easel.ts).
+ *
+ * in IPointerEvent
+ * out IPointerEvent
+ */
+export class PencilAwareLimiter {
+    private chainOut: TChainOutFunc | undefined;
+    private readonly legacy = new OnePointerLimiter();
+    private readonly touchLimiter = new OnePointerLimiter();
+    private readonly penLimiter = new OnePointerLimiter();
+    private isPenDown = false;
+    private readonly ignoredTouchIds = new Set<number>();
+
+    // ----------------------------------- public -----------------------------------
+    chainIn(event: TPointerEvent): TPointerEvent | null {
+        if (!KL_CONFIG.pencilOnly) {
+            return this.legacy.chainIn(event);
+        }
+
+        if (event.pointerType === 'touch') {
+            if (this.ignoredTouchIds.has(event.pointerId)) {
+                if (event.type === 'pointerup') {
+                    this.ignoredTouchIds.delete(event.pointerId);
+                }
+                return null;
+            }
+            if (event.type === 'pointerdown' && this.isPenDown) {
+                this.ignoredTouchIds.add(event.pointerId);
+                return null;
+            }
+            const out = this.touchLimiter.chainIn(event);
+            return this.isPenDown ? null : out;
+        }
+
+        const out = this.penLimiter.chainIn(event);
+        if (out && event.type === 'pointerdown') {
+            this.isPenDown = true;
+        }
+        if (event.type === 'pointerup' && out) {
+            this.isPenDown = false;
+        }
+        return out;
+    }
+
+    setChainOut(func: TChainOutFunc): void {
+        this.chainOut = func;
+    }
+}
