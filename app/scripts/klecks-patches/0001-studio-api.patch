diff --git a/src/app/script/klecks/brushes-ui/brush-size-limits.ts b/src/app/script/klecks/brushes-ui/brush-size-limits.ts
new file mode 100644
index 0000000..2b29b66
--- /dev/null
+++ b/src/app/script/klecks/brushes-ui/brush-size-limits.ts
@@ -0,0 +1,31 @@
+// [creatofolio patch] New file. Klecks caps pen / blend / pixel brushes at 200 px and
+// the eraser at 400 px, which is tiny on the 4096-px backdrops drawn here.
+// The slider's size value is a RADIUS (the label shows value * 2), so a
+// diameter of D px is a slider value of D / 2.
+import { BB } from '../../bb/bb';
+import { TBrushUi } from '../kl-types';
+
+const SCALED_BRUSHES = ['penBrush', 'blendBrush', 'pixelBrush', 'eraserBrush', 'smudgeBrush'];
+
+/** Largest brush diameter (px) for a canvas: 1/8 of the long side, 500..1000. */
+export function maxBrushDiameterFor(width: number, height: number): number {
+    return Math.min(1000, Math.max(500, Math.round(Math.max(width, height) / 8)));
+}
+
+/** Raises (never lowers) the size slider max of the big brushes. The curve stays
+ *  a power curve, so small sizes keep their fine control. */
+export function applyBrushSizeLimits(
+    brushesUi: Record<string, TBrushUi<any>>,
+    width: number,
+    height: number,
+): void {
+    const maxRadius = maxBrushDiameterFor(width, height) / 2;
+    SCALED_BRUSHES.forEach((id) => {
+        const slider = brushesUi[id]?.sizeSlider;
+        if (!slider || slider.max >= maxRadius) {
+            return;
+        }
+        slider.max = maxRadius;
+        slider.curve = BB.powerSplineInput(slider.min, maxRadius, 0.1);
+    });
+}
