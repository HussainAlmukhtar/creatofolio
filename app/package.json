{
  "name": "creatofolio",
  "version": "0.1.0",
  "description": "A self-hostable, hand-drawn interactive portfolio builder: a walkable game world, a drawn landing-page CMS and admin editors.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HussainAlmukhtar/creatofolio.git",
    "directory": "app"
  },
  "homepage": "https://github.com/HussainAlmukhtar/creatofolio#readme",
  "bugs": "https://github.com/HussainAlmukhtar/creatofolio/issues",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-klecks.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "klecks:build": "node scripts/build-klecks.mjs",
    "db:seed": "tsx --env-file=.env.local src/scripts/seedSupabase.ts && tsx --env-file=.env.local src/scripts/migrations/002_mint_iids.ts && tsx --env-file=.env.local src/scripts/migrations/003_worlds.ts",
    "postinstall": "node scripts/build-klecks.mjs --if-missing",
    "db:seed:reset": "tsx --env-file=.env.local src/scripts/seedSupabase.ts --force && tsx --env-file=.env.local src/scripts/migrations/002_mint_iids.ts && tsx --env-file=.env.local src/scripts/migrations/003_worlds.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.102.1",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "konva": "^10.2.3",
    "lenis": "^1.3.23",
    "lucide-react": "^1.8.0",
    "next": "^16.4.6",
    "phaser": "^3.90.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.3",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.3",
    "react-konva": "^19.2.3",
    "react-moveable": "^0.56.0",
    "simple-icons": "^16.32.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "shadcn": "^4.23.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
