# Copy to .env.local and fill in. See the repository README, "Quick start".

# ── Supabase ────────────────────────────────────────────────────────────
# Without these the public site boots from the static seed (src/data/) and
# the editors warn that edits won't persist.
# Self-hosted Supabase: use its PUBLIC origin (e.g. https://db.example.com),
# not an internal Docker/LAN address.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (API routes). Bypasses Row Level Security: never expose it
# client-side and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Owner ───────────────────────────────────────────────────────────────
# The email of the ONE account allowed into /admin. Server-only. It must be
# the same address you inserted into the public.app_owner table: this value
# gates the admin pages and API routes, the table gates database writes.
OWNER_EMAIL=

# ── Site ────────────────────────────────────────────────────────────────
# Canonical origin for sitemap.xml / robots.txt / share cards, e.g.
# https://example.com. Unset: Vercel's production host if there is one, else
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional: public base URL of a bucket/CDN that serves uploaded files
# directly (e.g. a Cloudflare R2 custom domain). When set, every saved
# Storage URL (…/storage/v1/object/public/<bucket>/<path>) is rewritten to
# <this>/<bucket>/<path>, so the object keys must be <bucket>/<path>.
# Leave empty to serve files through Supabase Storage. See src/lib/storageUrl.ts.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=

# ── Forms (optional) ────────────────────────────────────────────────────
# Form-block submissions when Site settings → Forms = "Webhook". The payload
# is JSON: { form, page, pageUri, fields, submittedAt }; the optional secret
# is sent as the X-Form-Secret header. A ready-made Google Apps Script
# receiver is in docs/ops/contact-form-apps-script.gs.
# (Forms = "HubSpot" needs no variable: the portal and form ids are entered
# in Site settings.)
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=

# ── Maintenance page (optional) ─────────────────────────────────────────
# Visitor password for the maintenance page (Site settings → Maintenance).
# Without it the holding page just shows the message; the signed-in owner
# always gets in.
SITE_PASSWORD=

# ── World files (optional) ──────────────────────────────────────────────
# Set to 1 to allow writing per-room JSON files under app/world/ in
# production builds (off by default: container files are wiped on deploy).
ALLOW_WORLD_FILES=

# ── Build label (optional) ──────────────────────────────────────────────
# A commit id shown in the admin so you can tell which build is live. Many
# hosts set one of these for you; leave them out otherwise.
# SOURCE_COMMIT=
# GIT_SHA=
